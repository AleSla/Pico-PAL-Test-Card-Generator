.program video_out
.wrap_target
    out pins, 8
.wrap

% c-sdk {
static inline void video_out_program_init(PIO pio, uint sm, uint offset, uint pin_base) {
    pio_sm_config c = video_out_program_get_default_config(offset);
    sm_config_set_out_pins(&c, pin_base, 8);
    for(int i = 0; i < 8; i++) {
        pio_gpio_init(pio, pin_base + i);
    }
    pio_sm_set_consecutive_pindirs(pio, sm, pin_base, 8, true);
    sm_config_set_out_shift(&c, true, true, 8);
    sm_config_set_fifo_join(&c, PIO_FIFO_JOIN_TX);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
